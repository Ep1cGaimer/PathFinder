APP_ENV=development
DATABASE_URL=postgresql+psycopg://pathfinder:pathfinder@localhost:5432/pathfinder
VALKEY_URL=redis://localhost:6379/0

# Real keyless providers. Use ors+key for higher rate limits in production.
ROUTING_PROVIDER=osrm
GEOCODING_PROVIDER=photon
ROUTING_BASE_URL=https://api.openrouteservice.org
GEOCODING_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=
PHOTON_BASE_URL=https://photon.komoot.io
MAP_REGION_BBOX=77.35,12.75,77.85,13.20

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=road-reports
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Disabled during all product traffic; used only by scripts/compare_google_routes.py.
GOOGLE_RESEARCH_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=

ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:4173
MODEL_PATH=../trainedModels/ssd_mobilenet_innference_graph.pb

EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never commit populated environment files. Server credentials belong in deployment secrets.
